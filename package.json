{
  "name": "apia_project",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "build-dist": "npm run clean-dist && ./node_modules/typescript/bin/tsc",
    "build": "npm run clean-dist && ./node_modules/typescript/bin/tsc && cd client && npm run build",
    "clean-dist": "del-cli ./dist",
    "install-client": "cd client && npm install",
    "start": "nodemon ./server.ts",
    "client": "cd client && npm start",
    "dev": "concurrently -n 'server, client' -c 'green, blue' \"nodemon ./server.ts\" \"npm run client\"",
    "prod": "concurrently -n 'server, client' -c 'green, blue' \"node ./server.ts\" \"npm run client\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadinejuraschek/APIA_Project.git"
  },
  "author": "Nadine Pesso",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nadinejuraschek/APIA_Project/issues"
  },
  "homepage": "https://github.com/nadinejuraschek/APIA_Project#readme",
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "crypto": "^1.0.1",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^3.0.0",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@vitejs/plugin-react": "^5.0.4",
    "del-cli": "^6.0.0",
    "eslint-plugin-sort-destructure-keys": "^1.6.0",
    "lodash": "^4.17.21",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
